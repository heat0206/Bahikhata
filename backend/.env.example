# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed frontend URL(s) for CORS (comma-separated if multiple, e.g. https://prepboard.vercel.app)
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=prepboard

# AI Chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# OA Reminder & Email Configuration
APP_TIMEZONE=Asia/Kolkata
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="PrepBoard" <no-reply@prepboard.com>
